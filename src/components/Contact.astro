---
import { Image } from 'astro:assets';
import contactPhoto from '../assets/images/contact-photo.jpeg';
import samosaPhoto from '../assets/images/samosa.jpeg';
---

<section class="contact" id="contact">

  <!-- Desktop: col 2 top / Mobile: top (heading + CTAs) -->
  <div class="contact__top">
    <div class="contact__heading-wrap">
      <h2 class="contact__heading">
        Found something you liked?<br />Let's talk.
      </h2>
    </div>

    <p class="contact__subheading">
      For collabs, speaking, and partnerships or just to say hi!
    </p>

    <div class="contact__ctas">
      <a href="https://mail.google.com/mail/?view=cm&to=drcuterus@gmail.com" target="_blank" rel="noopener" class="btn-primary">Work With Me</a>
      <a href="https://www.instagram.com/dr_cuterus/" target="_blank" rel="noopener" class="btn-outline">See My Content</a>
    </div>
  </div>

  <!-- Desktop: col 1 / Mobile: middle (photo + samosa overlay) -->
  <div class="contact__photo-col">
    <Image
      src={contactPhoto}
      alt="Dr. Tanaya Narendra"
      class="contact__photo"
      widths={[400, 700, 1000]}
      sizes="(max-width: 768px) 100vw, 50vw"
    />
    <!-- Mobile-only: samosa overlaid on photo -->
    <Image
      src={samosaPhoto}
      alt="Samosa, Dr. Cuterus's dog"
      class="contact__samosa-overlay"
      width={140}
      height={140}
    />
  </div>

  <!-- Desktop: col 2 bottom / Mobile: bottom (arrow + email + socials) -->
  <div class="contact__bottom">
    <div class="contact__samosa">
      <p class="contact__samosa-text">Samosa says hi!</p>
      <Image
        src={samosaPhoto}
        alt="Samosa, Dr. Cuterus's dog"
        class="contact__samosa-img"
        width={140}
        height={140}
      />
    </div>


    <div class="contact__footer">
      <div class="contact__footer-top">
        <p class="contact__email">
          Can also reach out on:
          <a href="https://mail.google.com/mail/?view=cm&to=drcuterus@gmail.com" target="_blank" rel="noopener" class="contact__email-link">drcuterus@gmail.com</a>
        </p>
      </div>
      <div class="contact__footer-divider-wrap">
        <div class="contact__footer-divider"></div>
      </div>
      <p class="contact__socials">
        Learn about your body on:
        <a href="https://www.instagram.com/dr_cuterus/" target="_blank" rel="noopener" class="contact__social-link" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.youtube.com/@dr_cuterus" target="_blank" rel="noopener" class="contact__social-link" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="https://open.spotify.com/show/41cmfHeXZXHs1xuLV5rJdD" target="_blank" rel="noopener" class="contact__social-link" aria-label="Spotify">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
        </a>
      </p>
    </div>
  </div>

</section>

<div class="contact__pattern-strip">
  <span class="contact__strip-copy">© 2026 Tanaya Narendra. All rights reserved.</span>
  <span class="contact__strip-credit">Designed &amp; Developed by <a href="https://mail.google.com/mail/?view=cm&to=sanvikhandelwal2005@gmail.com" target="_blank" rel="noopener" class="contact__strip-link">ReWired Labs</a></span>
</div>

<style>
  .contact__pattern-strip {
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 60px;
    min-height: 48px;
  }

  .contact__strip-copy {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-brand-900);
    opacity: 0.85;
  }

  .contact__strip-credit {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-brand-900);
    opacity: 0.9;
  }

  .contact__strip-link {
    color: var(--color-brand-400);
    text-decoration: none;
    font-weight: 600;
  }

  .contact__strip-link:hover {
    text-decoration: underline;
  }

  /* ── DESKTOP GRID ── */
  .contact {
    background-color: var(--color-beige-500);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow: hidden;
  }

  .contact__photo-col {
    grid-column: 1;
    grid-row: 1 / 3;
    background-color: var(--color-yellow-500);
    position: relative;
    overflow: hidden;
  }

  .contact__top {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 140px 60px 32px 40px;
    gap: 16px;
    background-color: var(--color-beige-500);
  }

  .contact__bottom {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    padding: 0 60px 32px 40px;
    gap: 16px;
    background-color: var(--color-beige-500);
    position: relative;
  }

  /* Mobile samosa overlay — hidden on desktop */
  .contact__samosa-overlay {
    display: none;
  }

  /* PHOTO COLUMN */
  .contact__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }



  /* HEADING AREA */
  .contact__heading-wrap {
    position: relative;
    padding: 40px 0 0;
  }

  .contact__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    color: var(--color-brand-900);
    margin: 0 0 12px;
    line-height: 1.1;
    letter-spacing: -0.06em;
    text-align: center;
  }

  .contact__subheading {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--color-brand-900);
    margin: 0 0 12px;
    max-width: 600px;
    text-align: center;
    align-self: center;
  }

  .contact__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
    justify-content: center;
  }

  /* SAMOSA (desktop) */
  .contact__samosa {
    display: flex;
    align-items: center;
    gap: 16px;
    align-self: flex-end;
    margin-bottom: 20px;
  }

  .contact__samosa-text {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--color-brand-900);
    margin: 0;
  }

  .contact__samosa-img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
  }

  /* ARROW */
  /* FOOTER */
  .contact__footer {
    border-top: none;
    margin-top: auto;
  }

  .contact__footer-top {
    margin-bottom: 4px;
  }

  .contact__email {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-brand-900);
    margin: 0 0 4px;
    text-align: right;
  }

  .contact__email-link {
    color: var(--color-brand-900);
    text-decoration: underline;
    text-decoration-color: var(--color-brand-400);
    text-underline-offset: 2px;
  }

  .contact__footer-divider-wrap {
    margin-bottom: 6px;
  }

  .contact__footer-divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-brand-900);
    opacity: 0.3;
  }

  .contact__socials {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-brand-900);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .contact__social-link {
    color: var(--color-brand-400);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .contact__social-link:hover {
    color: var(--color-brand-600);
    opacity: 0.8;
  }

  /* TABLET */
  @media (max-width: 1024px) and (min-width: 769px) {
    .contact__top {
      padding: 40px 32px 24px 28px;
    }

    .contact__bottom {
      padding: 0 32px 24px 28px;
    }

    .contact__flower--purple {
      right: 80px;
    }

    .contact__samosa-img {
      width: min(120px, 15vw);
      height: min(120px, 15vw);
    }
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .contact {
      display: flex;
      flex-direction: column;
      height: 100svh;
      padding-top: 56px;
      overflow: hidden;
    }

    /* Top: heading + CTAs */
    .contact__top {
      flex-shrink: 0;
      padding: 24px 20px 20px;
      gap: 28px;
      justify-content: flex-start;
      align-items: center;
    }

    .contact__heading-wrap {
      padding-top: 12px;
    }

    .contact__heading {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
      line-height: 0.9;
      margin-bottom: 0;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    /* Remove subheading on mobile */
    .contact__subheading {
      display: none !important;
    }

    .contact__ctas {
      justify-content: center;
      gap: 10px;
      margin-bottom: 0;
      flex-wrap: nowrap;
    }

    .contact__ctas :global(a) {
      min-width: 0;
    }

    /* Middle: photo fills remaining space */
    .contact__photo-col {
      flex: 1;
      min-height: 0;
    }

    /* Samosa overlaid on photo — circular, bottom-right */
    .contact__samosa-overlay {
      display: block;
      position: absolute;
      bottom: 16px;
      right: 16px;
      width: clamp(70px, 20vw, 100px);
      height: clamp(70px, 20vw, 100px);
      border-radius: 50%;
      object-fit: cover;
      z-index: 3;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* Bottom: arrow + email + socials */
    .contact__bottom {
      flex-shrink: 0;
      padding: 8px 20px 10px;
      gap: 4px;
    }

    /* Hide desktop samosa on mobile */
    .contact__samosa {
      display: none;
    }

    .contact__footer {
      margin-top: 0;
    }

    .contact__email {
      text-align: center;
      line-height: 1.35;
      margin-bottom: 4px;
    }

    .contact__socials {
      justify-content: center;
      gap: 10px;
      margin-bottom: 4px;
    }

    .contact__pattern-strip {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      padding: 16px 20px;
      gap: 8px;
    }
  }

  /* Small phones */
  @media (max-width: 768px) and (max-height: 700px) {
    .contact__top {
      padding: 8px 20px 6px;
      gap: 6px;
    }

    .contact__heading {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }

    .contact__bottom {
      padding: 6px 20px 8px;
    }
  }
</style>
