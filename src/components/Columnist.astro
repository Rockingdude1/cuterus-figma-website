---
---

<div class="columnist-outer" id="columnist">
  <section class="columnist">

    <!-- LEFT: composited stamp + photo -->
    <div class="columnist__photo-col">
      <img src="/columnist/image-columnist.png" class="col__image" alt="Dr. Tanaya Narendra holding a copy of Mumbai Mirror, writer of the Ask The Sexpert sex education column" loading="lazy" />
    </div>

    <!-- RIGHT: grid bg + content -->
    <div class="columnist__right">
      <div class="columnist__content-group">

        <h2 class="columnist__heading">
          <span class="columnist__text--hinglish">Aapki Local Sexpert.</span>
          <span class="columnist__text--english">Your Next Door Sexpert.</span>
        </h2>

        <div class="columnist__desc-box">
          <p>
            <span class="columnist__text--hinglish"><strong>Dr. Mahindra Watsa</strong> ke legendary sex column ko Mumbai Mirror mein aage badhate huye main har din aapke sawaalon ka jawaab deti hoon. Aap apne sawaal lekar mujhse contact kar sakte hai. Apne body ke baare mein jaanna kabhi embarrassing nahi hota.</span>
            <span class="columnist__text--english">Carrying forward <strong>Dr. Mahindra Watsa's</strong> legendary sex column in Mumbai Mirror; everyday, I reply to all of your queries. Anyone with queries can reach out to me. It is never embarrassing to ask to know more about your own body.</span>
          </p>
        </div>

        <a href="https://mumbaimirror.indiatimes.com/ask-the-sexpert"
           target="_blank" rel="noopener"
           class="btn-primary columnist__cta">Read It Now →</a>

      </div>
    </div>

  </section>
</div>

<style>
  /* ── OUTER ── */
  .columnist-outer {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  /* ── SECTION: two-column grid ── */
  .columnist {
    width: 100%;
    display: grid;
    grid-template-columns: 41.67% 1fr;
    min-height: 100svh;
    max-height: 900px;
  }

  /* ── LEFT: photo column ── */
  .columnist__photo-col {
    position: relative;
    overflow: hidden;
    background-color: var(--color-beige-500);
  }

  /* Composited stamp + photo — fits visible height below navbar, never crops */
  .col__image {
    position: absolute;
    height: calc(100% - 80px);
    width: auto;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
  }

  /* ── RIGHT: grid background ── */
  .columnist__right {
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 74px 40px 74px;
  }

  /* Content group */
  .columnist__content-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: min(570px, 100%);
  }

  /* Heading */
  .columnist__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(2rem, 3.75vw, 3rem);
    color: var(--color-brand-900);
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0;
    text-align: center;
  }

  /* Description box — white background */
  .columnist__desc-box {
    background-color: var(--color-white);
    padding: 8px 26px;
    width: 100%;
  }

  .columnist__desc-box p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1rem, 1.5vw, 1.75rem);
    color: var(--color-black);
    text-align: center;
    margin: 0;
    line-height: 1.4;
  }

  .columnist__desc-box strong { font-weight: 700; }

  /* ── LANGUAGE TOGGLE ── */
  .columnist__text--english { display: none; }
  :global([data-lang="english"]) .columnist__text--english  { display: inline; }
  :global([data-lang="english"]) .columnist__text--hinglish { display: none; }

  /* CTA */
  .columnist__cta {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    padding: 12px 20px;
  }

  /* ── MOBILE + TABLET (≤1024px) ── */
  @media (max-width: 1024px) {
    .columnist-outer {
      height: 100svh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 56px; /* navbar height */
      box-sizing: border-box;
    }

    .columnist {
      display: flex;
      flex-direction: column;
      min-height: unset;
      max-height: unset;
    }

    /* Photo col: fixed height so it never stretches on tall phones */
    .columnist__photo-col {
      flex: 0 0 clamp(300px, 52svh, 420px);
    }

    /* Image: fill the fixed photo col, no desktop navbar offset */
    .col__image {
      top: 0;
      height: 100%;
    }

    /* Right: content-sized, not stretching */
    .columnist__right {
      flex: 0 0 auto;
      padding: 20px 24px;
      background-color: var(--color-beige-500);
      background-image: none;
    }

    .columnist__desc-box {
      background-color: var(--color-brand-100);
    }

    .columnist__content-group {
      gap: 12px;
    }

    .columnist__heading {
      font-size: clamp(24px, 7.5vw, 34px);
    }

    .columnist__desc-box {
      padding: 6px 16px;
    }

    .columnist__desc-box p { font-size: clamp(13px, 3.75vw, 16px); }
    .columnist__cta { font-size: clamp(15px, 4.25vw, 18px); padding: 8px 16px; }
  }

  /* ── Tablet larger sizes — iPad Mini 6 (744px) and up ── */
  @media (min-width: 720px) and (max-width: 1024px) {
    .columnist__photo-col {
      flex: 0 0 clamp(420px, 58svh, 560px);
    }

    .columnist__right {
      padding: 36px 48px;
    }

    .columnist__content-group {
      gap: 24px;
    }

    .columnist__heading {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
    }

    .columnist__desc-box {
      padding: 14px 28px;
    }

    .columnist__desc-box p {
      font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    }

    .columnist__cta {
      font-size: clamp(1.25rem, 2.5vw, 1.75rem);
      padding: 14px 28px;
    }
  }

  /* ── Tablet navbar offset — only where desktop nav (80px) shows ── */
  @media (min-width: 769px) and (max-width: 1024px) {
    .columnist-outer { padding-top: 80px; }
  }

  /* ── iPad Pro portrait (1024×1366) — raise photo cap ── */
  @media (min-width: 769px) and (max-width: 1024px) and (min-height: 1300px) {
    .columnist__photo-col {
      flex: 0 0 clamp(560px, 58svh, 720px);
    }
  }
</style>
