---
import { Image } from 'astro:assets';
import fursatLogo from '../assets/images/fursat-logo.png';
import fursat1 from '../assets/images/fursat-1.png';
import fursat2 from '../assets/images/fursat-2.png';
import fursat3 from '../assets/images/fursat-3.png';
import fursat4 from '../assets/images/fursat-4.png';

const episodes = [
  { id: 'Ilh3ggln2QY', title: 'Ep 1' },
  { id: 'plgYmhTATNU', title: 'Ep 2' },
  { id: 'deR39hj6Mp0', title: 'Ep 3' },
  { id: 'VVpIK-wnZGA', title: 'Ep 4' },
  { id: '70phJGlY5Ok', title: 'Ep 5' },
  { id: 'eVhxjUTIbNA', title: 'Ep 6' },
  { id: 'KrH1qWJvink', title: 'Ep 7' },
  { id: 'vZ8uH-W7w5Y', title: 'Ep 8' },
  { id: 'S6Ihn4bd3T4', title: 'Ep 9' },
];
---

<div class="fursat-outer" id="fursat">

  <!-- ── TOP: Bra section ── -->
  <section class="fursat">
    <div class="fursat__left">
      <h2 class="fursat__heading">Made a bra for you</h2>

      <div class="fursat__desc-wrap">
        <div class="fursat__logo-row">
          <Image src={fursatLogo} alt="Fursat bra logo, by Dr. Tanaya Narendra" class="fursat__logo" loading="lazy" />
        </div>
        <div class="fursat__desc-box">
          <p class="fursat__desc fursat__desc--desktop">
            <span class="fursat__desc-text--hinglish">aur main proudly present karti hoon <strong>FURSAT</strong>: hamara <strong>cloud-soft</strong>, <strong>medium-impact bra</strong>, jo aapko (aur aapki bewbies ko) pyaar se support karega.</span>
            <span class="fursat__desc-text--english">and I proudly present <strong>FURSAT</strong>: our <strong>cloud-soft</strong>,{" "}
            <strong>medium-impact bra</strong> designed to hold you (and your bewbies) with love.</span>
          </p>
          <p class="fursat__desc fursat__desc--mobile">
            <span class="fursat__desc-text--hinglish">aur main present karti hoon <strong>FURSAT</strong>: hamara <strong>cloud-soft</strong>,<br/>
            <strong>medium-impact bra</strong>.</span>
            <span class="fursat__desc-text--english">and I present <strong>FURSAT</strong>: our <strong>cloud-soft</strong>,<br/>
            <strong>medium-impact bra</strong>.</span>
          </p>
        </div>
      </div>

      <ul class="fursat__features">
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Wide straps (no angry shoulders)
        </li>
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Dreamy colours
        </li>
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Sexy backs (Justin Timberlake, we're watching)
        </li>
      </ul>

      <div class="fursat__quote-box">
        <p class="fursat__quote">
          For the girl who works hard, stretches slow, cries easy, and deserves every second of fursat.
        </p>
      </div>

      <div class="fursat__cta-wrap">
        <img src="/doodles/fursat-cat.svg" alt="" class="fursat__cat" aria-hidden="true" />
        <a href="https://letstilt.com/collections/fursat-bras" target="_blank" rel="noopener" class="btn-primary fursat__cta">Order your Fursat now</a>
        <p class="fursat__cta-sub">and your boobs will thank you.</p>
      </div>
    </div>

    <div class="fursat__right">
      <div class="fursat__photo-wrap">

        <!-- Colour variant frames — shown on all breakpoints -->
        <div class="fursat__frame fursat__frame--variant is-active" data-variant="1">
          <Image src={fursat1} alt="Fursat cloud-soft medium-impact bra in colour 1 by Dr Cuterus" class="fursat__photo" loading="lazy" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="2">
          <Image src={fursat2} alt="Fursat cloud-soft medium-impact bra in colour 2 by Dr Cuterus" class="fursat__photo" loading="lazy" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="3">
          <Image src={fursat3} alt="Fursat cloud-soft medium-impact bra in colour 3 by Dr Cuterus" class="fursat__photo" loading="lazy" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="4">
          <Image src={fursat4} alt="Fursat cloud-soft medium-impact bra in colour 4 by Dr Cuterus" class="fursat__photo" loading="lazy" />
        </div>

        <!-- Colour swatches — shown on all breakpoints -->
        <div class="fursat__swatches">
          <button class="fursat__swatch fursat__swatch--1 is-active" data-variant="1" type="button" aria-label="Colour 1"></button>
          <button class="fursat__swatch fursat__swatch--2" data-variant="2" type="button" aria-label="Colour 2"></button>
          <button class="fursat__swatch fursat__swatch--3" data-variant="3" type="button" aria-label="Colour 3"></button>
          <button class="fursat__swatch fursat__swatch--4" data-variant="4" type="button" aria-label="Colour 4"></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BOTTOM: Podcast section ── -->
  <section class="fursat__podcast">
    <div class="fursat__podcast-header-wrap">
      <p class="fursat__podcast-title">Breast Friends Podcast</p>
    </div>
    <div class="fursat__podcast-body">
      <button class="fursat__podcast-nav fursat__podcast-prev" type="button" aria-label="Previous episodes">
        <img src="/doodles/arrow-content.svg" class="fursat__podcast-arrow fursat__podcast-arrow--left" alt="" />
      </button>
      <div class="fursat__podcast-viewport">
        <div class="fursat__podcast-track" id="fursat-podcast-track">
          {episodes.map((ep) => (
            <div class="fursat__episode" data-ep-id={ep.id} data-ep-title={`Breast Friends Podcast ${ep.title}`}>
              <div class="fursat__video">
                <img
                  class="fursat__thumb"
                  src={`https://img.youtube.com/vi/${ep.id}/hqdefault.jpg`}
                  alt={`Breast Friends Podcast ${ep.title.replace('Ep', 'Episode')} thumbnail, Dr. Tanaya Narendra`}
                  loading="lazy"
                />
                <button class="fursat__play" type="button" aria-label={`Play ${ep.title}`}>
                  <svg viewBox="0 0 68 48" width="52" height="36" aria-hidden="true">
                    <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/>
                    <path d="M45 24 27 14v20" fill="#fff"/>
                  </svg>
                </button>
              </div>
              <div class="fursat__episode-pill">{ep.title}</div>
            </div>
          ))}
        </div>
      </div>
      <button class="fursat__podcast-nav fursat__podcast-next" type="button" aria-label="Next episodes">
        <img src="/doodles/arrow-content.svg" class="fursat__podcast-arrow" alt="" />
      </button>
    </div>
  </section>

</div>

<style>
  /* ── OUTER WRAPPER (scroll-snap target) ── */
  .fursat-outer {
    height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── TOP: BRA SECTION ── */
  .fursat {
    background-color: var(--color-beige-500);
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── LEFT ── */
  .fursat__left {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px 40px 28px 60px;
    gap: 14px;
  }

  .fursat__desc-wrap {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  .fursat__logo-row {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-15%, -45%);
    z-index: 2;
  }

  .fursat__logo {
    width: 68px;
    height: auto;
    transform: rotate(-10deg);
  }

  .fursat__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-brand-400);
    margin: 0;
    letter-spacing: -0.06em;
    line-height: 1;
    text-align: center;
    max-width: 520px;
  }

  .fursat__desc-box {
    background-color: var(--color-brand-100);
    padding: 10px 14px;
    max-width: 520px;
  }

  .fursat__desc {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-black);
    margin: 0;
    line-height: 1.3;
  }

  .fursat__desc--mobile {
    display: none;
  }

  /* ── LANGUAGE TOGGLE ── */
  .fursat__desc-text--english { display: none; }
  :global([data-lang="english"]) .fursat__desc-text--english  { display: inline; }
  :global([data-lang="english"]) .fursat__desc-text--hinglish { display: none; }

  .fursat__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    max-width: 520px;
  }

  .fursat__feature {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-black);
    line-height: 1.2;
  }

  .fursat__bullet {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Quote box not shown on desktop (not in Figma); kept for mobile via tablet override */
  .fursat__quote-box {
    display: none;
  }

  .fursat__quote {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-black);
    margin: 0;
    line-height: 1.4;
  }

  .fursat__cta-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    max-width: 520px;
    margin-top: 48px;
  }

  /* Cat SVG: sits beside/above the CTA button */
  .fursat__cat {
    position: absolute;
    bottom: calc(100% - 42px);
    left: -10%;
    width: 100px;
    height: auto;
    pointer-events: none;
  }

  .fursat__cta {
    font-size: 1rem;
  }

  .fursat__cta-sub {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-black);
    margin: 0;
  }

  /* ── RIGHT: photo column ── */
  .fursat__right {
    overflow: hidden;
    background-color: #ffe07f;
    position: relative;
    padding-top: 80px;
  }

  .fursat__photo-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ── VARIANT FRAMES: all breakpoints ── */
  @keyframes fursat-reveal {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }

  .fursat__frame--variant {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .fursat__frame--variant.is-active {
    pointer-events: auto;
    animation: fursat-reveal 0.3s ease forwards;
  }

  .fursat__frame--variant .fursat__photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center top;
    transform: scale(1.2);
    transform-origin: center top;
  }

  /* ── SWATCHES: all breakpoints — desktop on left side ── */
  .fursat__swatches {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .fursat__swatch {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .fursat__swatch.is-active {
    transform: scale(1.12);
  }

  .fursat__swatch--1 { background-color: #C5A882; }
  .fursat__swatch--2 { background-color: #222020; }
  .fursat__swatch--3 { background-color: #D49BB5; }
  .fursat__swatch--4 { background-color: #6BCECA; }

  .fursat__swatch--1.is-active { border-color: #9E6229; }
  .fursat__swatch--2.is-active { border-color: #000000; }
  .fursat__swatch--3.is-active { border-color: #965462; }
  .fursat__swatch--4.is-active { border-color: #1F625D; }

  /* ── BOTTOM: PODCAST SECTION ── */
  .fursat__podcast {
    flex: 0 0 42%;
    max-height: 360px;
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    border-top: 1px solid var(--color-brand-500, #3d1f5c);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .fursat__podcast-header-wrap {
    flex-shrink: 0;
    background-color: var(--color-brand-300);
    padding: 8px 20px;
    align-self: center;
    margin-top: 16px;
  }

  .fursat__podcast-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-white);
    text-align: center;
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0;
    white-space: nowrap;
  }

  .fursat__podcast-body {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 0;
    padding: clamp(10px, 2.5vh, 28px) 0;
  }

  .fursat__podcast-nav {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .fursat__podcast-nav:hover { opacity: 1; }
  .fursat__podcast-nav:disabled { opacity: 0.25; cursor: default; }

  .fursat__podcast-arrow {
    width: 27px;
    height: auto;
    display: block;
  }

  .fursat__podcast-arrow--left {
    transform: scaleX(-1);
  }

  .fursat__podcast-viewport {
    flex: 1;
    overflow: hidden;
    min-width: 0;
  }

  .fursat__podcast-track {
    display: flex;
    gap: 16px;
    align-items: center;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  /* width set by JS; height is auto from pill + video */
  .fursat__episode {
    flex: 0 0 auto;
    overflow: visible;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .fursat__episode-pill {
    flex-shrink: 0;
    border: 1px solid var(--color-black);
    border-radius: 100px;
    padding: 2px 16px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-black);
    white-space: nowrap;
    background: transparent;
  }

  .fursat__video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    background: var(--color-brand-900);
    overflow: hidden;
    cursor: pointer;
  }

  .fursat__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fursat__play {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .fursat__play:hover {
    background: rgba(0, 0, 0, 0.06);
  }


  /* Hide sub-text on short laptop screens where it would encroach on the podcast grid */
  @media (min-width: 769px) and (max-height: 820px) {
    .fursat__cta-sub {
      display: none;
    }
  }

  /* ── TABLET (769–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .fursat__left {
      padding: 48px 24px 48px 32px;
    }

    .fursat__heading,
    .fursat__desc-box,
    .fursat__features,
    .fursat__cta-wrap {
      max-width: 90%;
    }

    /* swatches on right side on tablet (less space on left) */
    .fursat__swatches {
      left: auto;
      right: 12px;
    }

    .fursat__podcast {
      flex: 0 0 290px;
    }
  }

  /* ── MOBILE (≤768px) ── */
  @media (max-width: 768px) {
    /* Bra section: column — photo on top, content below */
    .fursat {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    /* RIGHT: photo area — top portion with navbar offset */
    .fursat__right {
      order: 1;
      flex: 0 0 42svh;
      padding-top: 56px;
      padding-bottom: 0;
      background-color: #ffe07f;
      position: relative;
      overflow: hidden;
    }

    .fursat__photo-wrap {
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    /* Swatches: right side on mobile (matches Figma) */
    .fursat__swatches {
      left: auto;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      gap: 8px;
    }

    .fursat__swatch {
      width: 36px;
      height: 36px;
    }

    /* LEFT: text content — visible below photo on mobile */
    .fursat__left {
      order: 2;
      flex: 1;
      display: flex !important;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 10px 20px 8px;
      gap: 8px;
      overflow: hidden;
      background-color: var(--color-beige-500);
    }

    /* Hide feature bullets, quote pill on mobile */
    .fursat__features,
    .fursat__quote-box {
      display: none !important;
    }

    /* Heading: dark purple, left-aligned, larger */
    .fursat__heading {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      color: var(--color-brand-900);
      text-align: center;
      width: 100%;
      max-width: 100%;
    }

    /* Desc wrap + box: full width */
    .fursat__desc-wrap {
      width: 100%;
      max-width: 100%;
    }

    .fursat__desc-box {
      max-width: 100%;
    }

    .fursat__desc--desktop {
      display: none;
    }

    .fursat__desc--mobile {
      display: block;
    }

    .fursat__desc {
      font-size: 0.875rem;
      text-align: center;
      line-height: 1.4;
    }

    /* CTA wrap: less top spacing on mobile */
    .fursat__cta-wrap {
      margin-top: 13px;
    }

    .fursat__cat {
      width: 80px;
    }

    .fursat__cta {
      font-size: 0.9375rem;
      padding: 8px 16px;
    }

    .fursat__cta-sub {
      font-size: 0.75rem;
    }

    /* PODCAST: fixed bottom ~30% */
    .fursat__podcast {
      flex: 0 0 30svh;
      max-height: none;
    }

    .fursat__podcast-header-wrap {
      margin-top: 8px;
    }

    .fursat__podcast-title {
      font-size: 0.8rem;
    }

    .fursat__podcast-body {
      padding: clamp(6px, 1.5vh, 16px) 0;
    }

    .fursat__podcast-nav {
      padding: 0 10px;
    }
  }

  /* ── Small phones ── */
  @media (max-width: 768px) and (max-height: 700px) {
    .fursat__right {
      flex: 0 0 38svh;
    }

    .fursat__podcast {
      flex: 0 0 28svh;
    }
  }
</style>

<script>
  // ── Colour swatch switcher (all breakpoints) ──
  const wrap = document.querySelector<HTMLElement>('.fursat__photo-wrap');
  if (wrap) {
    wrap.querySelectorAll<HTMLButtonElement>('.fursat__swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        const variant = btn.dataset.variant;
        wrap.querySelectorAll('.fursat__swatch').forEach(s => s.classList.remove('is-active'));
        btn.classList.add('is-active');
        wrap.querySelectorAll('.fursat__frame--variant').forEach(f => f.classList.remove('is-active'));
        const nextFrame = wrap.querySelector<HTMLElement>(`.fursat__frame--variant[data-variant="${variant}"]`);
        if (nextFrame) {
          void nextFrame.offsetHeight; // force reflow to restart animation
          nextFrame.classList.add('is-active');
        }
      });
    });
  }

  // ── Podcast episode carousel ──
  const track = document.getElementById('fursat-podcast-track') as HTMLElement | null;
  const prevBtn = document.querySelector<HTMLButtonElement>('.fursat__podcast-prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.fursat__podcast-next');
  const TOTAL = 9;
  const GAP = 16;
  let podcastIdx = 0;

  function getVisibleCount(): number {
    if (window.innerWidth <= 768) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 3;
  }

  function setEpisodeSizes() {
    if (!track) return;
    const viewport = track.parentElement as HTMLElement;
    const body = document.querySelector<HTMLElement>('.fursat__podcast-body');
    const vis = getVisibleCount();

    // Width constraint: how wide each slide can be to fit N side-by-side
    const maxW = (viewport.clientWidth - GAP * (vis - 1)) / vis;
    // Height constraint: subtract actual rendered padding + pill reserve so video never overflows
    const PILL_RESERVE = 34;
    const bodyPad = body
      ? parseFloat(getComputedStyle(body).paddingTop) + parseFloat(getComputedStyle(body).paddingBottom)
      : 24;
    const maxH = body ? body.clientHeight - bodyPad - PILL_RESERVE : 9999;

    // Pick whichever constraint keeps the video smaller (contain behaviour)
    const wFromH = maxH * (16 / 9);
    const slideW = Math.min(maxW, wFromH);

    track.querySelectorAll<HTMLElement>('.fursat__episode').forEach(ep => {
      ep.style.width = `${slideW}px`;
    });
  }

  function updateTrack() {
    if (!track) return;
    const ep = track.querySelector<HTMLElement>('.fursat__episode');
    if (!ep) return;
    const offset = podcastIdx * (ep.offsetWidth + GAP);
    track.style.transform = `translateX(-${offset}px)`;
    const vis = getVisibleCount();
    if (prevBtn) prevBtn.disabled = podcastIdx === 0;
    if (nextBtn) nextBtn.disabled = podcastIdx >= TOTAL - vis;
  }

  function init() {
    podcastIdx = 0;
    setEpisodeSizes();
    updateTrack();
  }

  prevBtn?.addEventListener('click', () => {
    if (podcastIdx > 0) { podcastIdx--; updateTrack(); }
  });

  nextBtn?.addEventListener('click', () => {
    if (podcastIdx < TOTAL - getVisibleCount()) { podcastIdx++; updateTrack(); }
  });

  // Click-to-play: open YouTube video in new tab
  document.querySelectorAll<HTMLElement>('.fursat__play').forEach(btn => {
    btn.addEventListener('click', () => {
      const ep = btn.closest<HTMLElement>('.fursat__episode');
      if (!ep) return;
      const id = ep.dataset.epId;
      if (!id) return;
      window.open(`https://www.youtube.com/watch?v=${id}`, '_blank', 'noopener,noreferrer');
    });
  });

  // Init on load and re-layout on resize
  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init, { once: true });
  }
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(init, 100);
  });
</script>
