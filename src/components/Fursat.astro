---
import { Image } from 'astro:assets';
import fursatLogo from '../assets/images/fursat-logo.png';
import fursat1 from '../assets/images/fursat-1.png';
import fursat2 from '../assets/images/fursat-2.png';
import fursat3 from '../assets/images/fursat-3.png';
import fursat4 from '../assets/images/fursat-4.png';

const episodes = [
  { id: 'Ilh3ggln2QY', title: 'Ep 1' },
  { id: 'plgYmhTATNU', title: 'Ep 2' },
  { id: 'deR39hj6Mp0', title: 'Ep 3' },
  { id: 'VVpIK-wnZGA', title: 'Ep 4' },
  { id: '70phJGlY5Ok', title: 'Ep 5' },
  { id: 'eVhxjUTIbNA', title: 'Ep 6' },
  { id: 'KrH1qWJvink', title: 'Ep 7' },
  { id: 'vZ8uH-W7w5Y', title: 'Ep 8' },
  { id: 'S6Ihn4bd3T4', title: 'Ep 9' },
];
---

<div class="fursat-outer" id="fursat">

  <!-- ── TOP: Bra section ── -->
  <section class="fursat">
    <div class="fursat__left">
      <h2 class="fursat__heading">Made a bra for you</h2>

      <div class="fursat__desc-wrap">
        <div class="fursat__logo-row">
          <Image src={fursatLogo} alt="Fursat" class="fursat__logo" />
        </div>
        <div class="fursat__desc-box">
          <p class="fursat__desc">
            and I proudly present <strong>FURSAT</strong>: our <strong>cloud-soft</strong>,{" "}
            <strong>medium-impact bra</strong> designed to hold you (and your bewbies) with love.
          </p>
        </div>
      </div>

      <ul class="fursat__features">
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Wide straps (no angry shoulders)
        </li>
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Dreamy colours
        </li>
        <li class="fursat__feature">
          <img src="/doodles/fursat-bullets.svg" alt="" class="fursat__bullet" width="23" height="23" />
          Sexy backs (Justin Timberlake, we're watching)
        </li>
      </ul>

      <div class="fursat__quote-box">
        <p class="fursat__quote">
          For the girl who works hard, stretches slow, cries easy, and deserves every second of fursat.
        </p>
      </div>

      <div class="fursat__cta-wrap">
        <img src="/doodles/fursat-cat.svg" alt="" class="fursat__cat" aria-hidden="true" />
        <a href="https://letstilt.com/collections/fursat-bras" target="_blank" rel="noopener" class="btn-primary fursat__cta">Order your Fursat Now</a>
        <p class="fursat__cta-sub">and your boobs will thank you.</p>
      </div>
    </div>

    <div class="fursat__right">
      <div class="fursat__photo-wrap">

        <!-- Colour variant frames — shown on all breakpoints -->
        <div class="fursat__frame fursat__frame--variant is-active" data-variant="1">
          <Image src={fursat1} alt="Fursat bra colour 1" class="fursat__photo" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="2">
          <Image src={fursat2} alt="Fursat bra colour 2" class="fursat__photo" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="3">
          <Image src={fursat3} alt="Fursat bra colour 3" class="fursat__photo" />
        </div>
        <div class="fursat__frame fursat__frame--variant" data-variant="4">
          <Image src={fursat4} alt="Fursat bra colour 4" class="fursat__photo" />
        </div>

        <!-- Colour swatches — shown on all breakpoints -->
        <div class="fursat__swatches">
          <button class="fursat__swatch fursat__swatch--1 is-active" data-variant="1" type="button" aria-label="Colour 1"></button>
          <button class="fursat__swatch fursat__swatch--2" data-variant="2" type="button" aria-label="Colour 2"></button>
          <button class="fursat__swatch fursat__swatch--3" data-variant="3" type="button" aria-label="Colour 3"></button>
          <button class="fursat__swatch fursat__swatch--4" data-variant="4" type="button" aria-label="Colour 4"></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BOTTOM: Podcast section ── -->
  <section class="fursat__podcast">
    <div class="fursat__podcast-header-wrap">
      <p class="fursat__podcast-title">Breast Friends Podcast</p>
    </div>
    <div class="fursat__podcast-body">
      <button class="fursat__podcast-nav fursat__podcast-prev" type="button" aria-label="Previous episodes">
        <img src="/doodles/arrow-content.svg" class="fursat__podcast-arrow fursat__podcast-arrow--left" alt="" />
      </button>
      <div class="fursat__podcast-viewport">
        <div class="fursat__podcast-track" id="fursat-podcast-track">
          {episodes.map((ep) => (
            <div class="fursat__episode">
              <iframe
                class="fursat__episode-iframe"
                src={`https://www.youtube-nocookie.com/embed/${ep.id}`}
                title={`Breast Friends Podcast ${ep.title}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
              <div class="fursat__episode-pill">{ep.title}</div>
            </div>
          ))}
        </div>
      </div>
      <button class="fursat__podcast-nav fursat__podcast-next" type="button" aria-label="Next episodes">
        <img src="/doodles/arrow-content.svg" class="fursat__podcast-arrow" alt="" />
      </button>
    </div>
  </section>

</div>

<style>
  /* ── OUTER WRAPPER (scroll-snap target) ── */
  .fursat-outer {
    height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── TOP: BRA SECTION ── */
  .fursat {
    background-color: var(--color-beige-500);
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── LEFT ── */
  .fursat__left {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px 40px 60px 60px;
    gap: 20px;
  }

  .fursat__desc-wrap {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  .fursat__logo-row {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-15%, -45%);
    z-index: 2;
  }

  .fursat__logo {
    width: 68px;
    height: auto;
    transform: rotate(-10deg);
  }

  .fursat__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: var(--color-brand-400);
    margin: 0;
    letter-spacing: -0.06em;
    line-height: 1;
    text-align: center;
    max-width: 520px;
  }

  .fursat__desc-box {
    background-color: var(--color-brand-100);
    padding: 12px 16px;
    max-width: 520px;
  }

  .fursat__desc {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--color-black);
    margin: 0;
    line-height: 1.2;
  }

  .fursat__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 520px;
  }

  .fursat__feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--color-black);
    line-height: 1;
  }

  .fursat__bullet {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .fursat__quote-box {
    border: 1px solid var(--color-black);
    border-radius: 100px;
    padding: 12px 24px;
    max-width: 520px;
  }

  .fursat__quote {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--color-black);
    margin: 0;
    line-height: 1.5;
  }

  .fursat__cta-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    max-width: 520px;
  }

  /* Cat SVG: sits beside/above the CTA button */
  .fursat__cat {
    position: absolute;
    bottom: calc(100% - 12px);
    left: -10%;
    width: 100px;
    height: auto;
    pointer-events: none;
  }

  .fursat__cta {
    font-size: 1rem;
  }

  .fursat__cta-sub {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-black);
    margin: 0;
  }

  /* ── RIGHT: photo column ── */
  .fursat__right {
    overflow: hidden;
    background-color: #ffe07f;
    position: relative;
    padding-top: 80px;
  }

  .fursat__photo-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ── VARIANT FRAMES: all breakpoints ── */
  .fursat__frame--variant {
    display: none;
    position: absolute;
    inset: 0;
  }

  .fursat__frame--variant.is-active {
    display: block;
  }

  .fursat__frame--variant .fursat__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* ── SWATCHES: all breakpoints — desktop on left side ── */
  .fursat__swatches {
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .fursat__swatch {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .fursat__swatch.is-active {
    transform: scale(1.12);
  }

  .fursat__swatch--1 { background-color: #C5A882; }
  .fursat__swatch--2 { background-color: #222020; }
  .fursat__swatch--3 { background-color: #D49BB5; }
  .fursat__swatch--4 { background-color: #6BCECA; }

  .fursat__swatch--1.is-active { border-color: #9E6229; }
  .fursat__swatch--2.is-active { border-color: #000000; }
  .fursat__swatch--3.is-active { border-color: #965462; }
  .fursat__swatch--4.is-active { border-color: #1F625D; }

  /* ── BOTTOM: PODCAST SECTION ── */
  .fursat__podcast {
    flex: 0 0 280px;
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    border-top: 1px solid var(--color-brand-500, #3d1f5c);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .fursat__podcast-header-wrap {
    flex-shrink: 0;
    background-color: var(--color-brand-300);
    padding: 8px 20px;
    align-self: center;
    margin-top: 16px;
  }

  .fursat__podcast-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-white);
    text-align: center;
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0;
    white-space: nowrap;
  }

  .fursat__podcast-body {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 0;
    padding: 12px 0;
  }

  .fursat__podcast-nav {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .fursat__podcast-nav:hover { opacity: 1; }
  .fursat__podcast-nav:disabled { opacity: 0.25; cursor: default; }

  .fursat__podcast-arrow {
    width: 27px;
    height: auto;
    display: block;
  }

  .fursat__podcast-arrow--left {
    transform: scaleX(-1);
  }

  .fursat__podcast-viewport {
    flex: 1;
    overflow: hidden;
    min-width: 0;
    height: 100%;
  }

  .fursat__podcast-track {
    display: flex;
    gap: 16px;
    height: 100%;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  /* width set by JS based on visible count */
  .fursat__episode {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    height: 100%;
  }

  .fursat__episode-iframe {
    flex: 1;
    width: 100%;
    border: none;
    display: block;
    min-height: 0;
    background: var(--color-brand-900);
  }

  .fursat__episode-pill {
    flex-shrink: 0;
    border: 1px solid var(--color-black);
    border-radius: 100px;
    padding: 2px 16px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-black);
    text-align: center;
    white-space: nowrap;
  }

  /* ── TABLET (769–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .fursat__left {
      padding: 48px 24px 48px 32px;
    }

    .fursat__heading,
    .fursat__desc-box,
    .fursat__features,
    .fursat__cta-wrap {
      max-width: 90%;
    }

    /* swatches on right side on tablet (less space on left) */
    .fursat__swatches {
      left: auto;
      right: 12px;
    }

    .fursat__podcast {
      flex: 0 0 260px;
    }
  }

  /* ── MOBILE (≤768px) ── */
  @media (max-width: 768px) {
    .fursat-outer {
      padding-top: 56px;
    }

    /* Top bra section: photo only, compressed height */
    .fursat {
      display: block;
      flex: 0 0 calc(55svh - 56px);
      overflow: hidden;
    }

    .fursat__left {
      display: none;
    }

    .fursat__right {
      height: 100%;
      width: 100%;
      padding-top: 0;
      background-color: #ffe07f;
      display: block;
    }

    .fursat__photo-wrap {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    /* swatches on right side on mobile */
    .fursat__swatches {
      left: auto;
      right: 8px;
      gap: 8px;
    }

    .fursat__swatch {
      width: 38px;
      height: 38px;
    }

    /* Podcast takes remaining height */
    .fursat__podcast {
      flex: 1;
      min-height: 0;
    }

    .fursat__podcast-header-wrap {
      margin-top: 8px;
    }

    .fursat__podcast-body {
      padding: 8px 0;
    }

    .fursat__podcast-nav {
      padding: 0 10px;
    }

    .fursat__episode-pill {
      font-size: 0.875rem;
      padding: 2px 10px;
    }
  }

  /* ── Small phones ── */
  @media (max-width: 768px) and (max-height: 700px) {
    .fursat {
      flex: 0 0 calc(50svh - 56px);
    }
  }
</style>

<script>
  // ── Colour swatch switcher (all breakpoints) ──
  const wrap = document.querySelector<HTMLElement>('.fursat__photo-wrap');
  if (wrap) {
    wrap.querySelectorAll<HTMLButtonElement>('.fursat__swatch').forEach(btn => {
      btn.addEventListener('click', () => {
        const variant = btn.dataset.variant;
        wrap.querySelectorAll('.fursat__swatch').forEach(s => s.classList.remove('is-active'));
        btn.classList.add('is-active');
        wrap.querySelectorAll('.fursat__frame--variant').forEach(f => f.classList.remove('is-active'));
        wrap.querySelector<HTMLElement>(`.fursat__frame--variant[data-variant="${variant}"]`)?.classList.add('is-active');
      });
    });
  }

  // ── Podcast episode carousel ──
  const track = document.getElementById('fursat-podcast-track') as HTMLElement | null;
  const prevBtn = document.querySelector<HTMLButtonElement>('.fursat__podcast-prev');
  const nextBtn = document.querySelector<HTMLButtonElement>('.fursat__podcast-next');
  const TOTAL = 9;
  const GAP = 16;
  let podcastIdx = 0;

  function getVisibleCount(): number {
    if (window.innerWidth <= 768) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 3;
  }

  function setEpisodeSizes() {
    if (!track) return;
    const viewport = track.parentElement as HTMLElement;
    const vis = getVisibleCount();
    const slideW = (viewport.clientWidth - GAP * (vis - 1)) / vis;
    track.querySelectorAll<HTMLElement>('.fursat__episode').forEach(ep => {
      ep.style.width = `${slideW}px`;
    });
  }

  function updateTrack() {
    if (!track) return;
    const ep = track.querySelector<HTMLElement>('.fursat__episode');
    if (!ep) return;
    const offset = podcastIdx * (ep.offsetWidth + GAP);
    track.style.transform = `translateX(-${offset}px)`;
    const vis = getVisibleCount();
    if (prevBtn) prevBtn.disabled = podcastIdx === 0;
    if (nextBtn) nextBtn.disabled = podcastIdx >= TOTAL - vis;
  }

  function init() {
    podcastIdx = 0;
    setEpisodeSizes();
    updateTrack();
  }

  prevBtn?.addEventListener('click', () => {
    if (podcastIdx > 0) { podcastIdx--; updateTrack(); }
  });

  nextBtn?.addEventListener('click', () => {
    if (podcastIdx < TOTAL - getVisibleCount()) { podcastIdx++; updateTrack(); }
  });

  // Init on load and re-layout on resize
  init();
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(init, 100);
  });
</script>
