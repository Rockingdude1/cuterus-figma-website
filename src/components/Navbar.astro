---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "Appointments", href: "/appointments" },
  { label: "Blog", href: "/blog" },
  { label: "Corporate Workshops", href: "/partnerships" },
];

const rawPath = Astro.url.pathname;
const currentPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
---

<header class="navbar">
  <a href="/" class="navbar__logo">Dr. Cuterus</a>

  <!-- Desktop nav -->
  <nav class="navbar__nav">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`navbar__link ${currentPath === link.href ? "navbar__link--active" : ""}`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Right group: CTA + lang toggle (desktop) / menu toggle (mobile) -->
  <div class="navbar__right">
    <button class="lang-toggle" id="desktop-lang-toggle" aria-label="Toggle language" data-lang="hinglish">
      <span class="lang-toggle__label" data-for="english">English</span>
      <span class="lang-toggle__track"><span class="lang-toggle__thumb"></span></span>
      <span class="lang-toggle__label" data-for="hinglish">Hinglish</span>
    </button>
    <button class="navbar__toggle" id="mobile-toggle" aria-label="Open menu" aria-expanded="false">Menu</button>
  </div>
</header>

<!-- Mobile full-page overlay -->
<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-menu__nav">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`mobile-menu__link ${currentPath === link.href ? "mobile-menu__link--active" : ""}`}
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>

<style>
  /* ── NAVBAR BAR ── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 60px;
    height: 80px;
    background: rgba(247, 240, 224, 0.1);
    backdrop-filter: blur(100px);
    -webkit-backdrop-filter: blur(100px);
    border-bottom: 2px solid rgba(28, 20, 23, 0.6);
  }

  .navbar__logo {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 1.875rem;
    color: var(--color-black);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ── RIGHT GROUP: CTA + lang toggle (desktop) / menu toggle (mobile) ── */
  .navbar__right {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-self: end;
  }

  /* ── DESKTOP NAV ── */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 1.7rem;
  }

  .navbar__link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--color-black);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
    position: relative;
  }

  .navbar__link:hover {
    color: var(--color-brand-400);
  }

  .navbar__link--active {
    font-weight: 700;
  }

  .navbar__link--active::after {
    content: "";
    position: absolute;
    left: -12px;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    height: 28px;
    background-color: var(--color-brand-100);
    border-radius: 20px;
    z-index: -1;
  }

  /* ── LANGUAGE TOGGLE ── */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 0.5px solid var(--color-brand-500);
    border-radius: 999px;
    padding: 8px 12px;
    background: var(--color-brand-100);
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .lang-toggle:hover { transform: scale(1.03); }

  .lang-toggle__label {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-brand-900);
    line-height: 1;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  /* Default (hinglish selected): english dim */
  .lang-toggle__label[data-for="english"] { opacity: 0.3; }
  .lang-toggle__label[data-for="hinglish"] { opacity: 1; }

  /* English selected */
  .lang-toggle[data-lang="english"] .lang-toggle__label[data-for="english"] { opacity: 1; }
  .lang-toggle[data-lang="english"] .lang-toggle__label[data-for="hinglish"] { opacity: 0.3; }

  .lang-toggle__track {
    width: 36px;
    height: 16px;
    border-radius: 999px;
    border: none;
    background: var(--color-brand-400);
    position: relative;
    flex-shrink: 0;
  }

  .lang-toggle__thumb {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    top: 50%;
    transform: translateY(-50%);
    left: 22px; /* hinglish default: right side */
    transition: left 0.2s ease;
  }

  /* English selected: thumb slides left */
  .lang-toggle[data-lang="english"] .lang-toggle__thumb { left: 2px; }

  /* ── MOBILE TOGGLE ── */
  .navbar__toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-black);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex-shrink: 0;
    line-height: 1;
    transition: background-color 0.2s ease;
  }

  /* ── MOBILE OVERLAY (hidden on desktop) ── */
  .mobile-menu {
    display: none;
  }

  /* ── TABLET (769–1024px) ── */
  @media (max-width: 1024px) and (min-width: 769px) {
    .navbar {
      padding: 0 32px;
    }

    .navbar__nav {
      gap: 1rem;
    }

    .navbar__logo {
      font-size: 1.5rem;
    }

    .navbar__cta {
      font-size: 0.875rem;
      padding: 8px 14px;
    }
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .navbar {
      padding: 0 20px;
      height: 56px;
      grid-template-columns: 1fr auto;
      background: rgba(247, 240, 224, 0.97);
    }

    .navbar__logo {
      font-size: 1.5rem;
    }

    /* Hide desktop nav (center column collapses) */
    .navbar__nav {
      display: none;
    }

    /* Hide desktop-only controls */
    .lang-toggle { display: none; }

    /* Show mobile toggle */
    .navbar__toggle {
      display: flex;
    }

    /* When menu is open, toggle morphs into the lang pill */
    .navbar__toggle.is-lang-toggle {
      display: flex;
      align-items: center;
      gap: 5px;
      background: var(--color-brand-100);
      border: 0.5px solid var(--color-brand-500);
      border-radius: 999px;
      padding: 5px 10px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--color-brand-900);
      letter-spacing: 0;
      text-transform: none;
      line-height: 1;
    }

    /* Inner pill elements are injected via JS so inline styles handle them */

    /* Full-page overlay, slides in from the right */
    .mobile-menu {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 200;
      background: var(--color-beige-500);
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mobile-menu.is-open {
      transform: translateX(0);
    }

    .mobile-menu__nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 100px 32px 40px;
    }

    .mobile-menu__link {
      font-family: var(--font-sans);
      font-size: 1.125rem;
      font-weight: 300;
      color: var(--color-black);
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      transition: color 0.2s ease;
      position: relative;
    }

    .mobile-menu__link:hover {
      color: var(--color-brand-400);
    }

    .mobile-menu__link--active {
      font-weight: 700;
    }

    .mobile-menu__link--active::after {
      content: "";
      position: absolute;
      left: -12px;
      right: -12px;
      top: 50%;
      transform: translateY(-50%);
      height: 28px;
      background-color: var(--color-brand-100);
      border-radius: 15px;
      z-index: -1;
    }

  }
</style>

<script>
  // ── LANGUAGE STATE ──
  const LANG_KEY = 'dr-cuterus-lang';

  function getSavedLang(): string {
    return localStorage.getItem(LANG_KEY) || 'hinglish';
  }

  function setLang(lang: string) {
    document.documentElement.setAttribute('data-lang', lang);
    localStorage.setItem(LANG_KEY, lang);
  }

  function updateToggleState(lang: string) {
    if (desktopToggle) desktopToggle.dataset.lang = lang;
  }

  // Init language on load
  const initLang = getSavedLang();
  setLang(initLang);

  const desktopToggle = document.getElementById('desktop-lang-toggle') as HTMLButtonElement;
  const mobileToggle = document.getElementById('mobile-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement;

  // Reflect saved lang in toggle on load
  updateToggleState(initLang);

  // ── DESKTOP LANG TOGGLE ──
  desktopToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-lang') || 'hinglish';
    const next = current === 'hinglish' ? 'english' : 'hinglish';
    setLang(next);
    updateToggleState(next);
  });

  // ── MOBILE NAV OPEN / CLOSE ──
  function openMenu() {
    menu.classList.add('is-open');
    mobileToggle.setAttribute('aria-expanded', 'true');
    mobileToggle.classList.add('is-lang-toggle');
    const lang = document.documentElement.getAttribute('data-lang') || 'hinglish';
    mobileToggle.dataset.lang = lang;
    const enOp = lang === 'english' ? 1 : 0.3;
    const hiOp = lang === 'hinglish' ? 1 : 0.3;
    const thumbLeft = lang === 'english' ? '2px' : '18px';
    mobileToggle.innerHTML = `
      <span style="font-family:var(--font-sans);font-size:0.9rem;font-weight:400;color:var(--color-brand-900);line-height:1;white-space:nowrap;opacity:${enOp};">English</span>
      <span style="width:32px;height:14px;border-radius:999px;background:var(--color-brand-400);position:relative;flex-shrink:0;display:inline-block;">
        <span style="position:absolute;width:10px;height:10px;border-radius:50%;background:#ffffff;top:50%;transform:translateY(-50%);left:${thumbLeft};"></span>
      </span>
      <span style="font-family:var(--font-sans);font-size:0.9rem;font-weight:400;color:var(--color-brand-900);line-height:1;white-space:nowrap;opacity:${hiOp};">Hinglish</span>
    `;
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.classList.remove('is-open');
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileToggle.classList.remove('is-lang-toggle');
    delete mobileToggle.dataset.lang;
    mobileToggle.textContent = 'Menu';
    document.body.style.overflow = '';
  }

  mobileToggle?.addEventListener('click', () => {
    if (menu.classList.contains('is-open')) {
      const current = document.documentElement.getAttribute('data-lang') || 'hinglish';
      const next = current === 'hinglish' ? 'english' : 'hinglish';
      setLang(next);
      updateToggleState(next);
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close menu when a nav link is tapped
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
