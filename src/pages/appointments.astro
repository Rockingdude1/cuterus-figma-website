---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import clinicImage from '../assets/images/clinic-image.png';

const reviews = [
  {
    text: "The coolest doctor ever! I'm a huge fan of her instagram account @dr_cuterus, where I get regular information about health & wellness. She is articulate about her thoughts & the info she wants to convey.",
    name: "Naman Pataria",
    url: "https://maps.app.goo.gl/tQnqi9NbgDePA2Nh6"
  },
  {
    text: "Coolest and the most knowledgeable doctors I have ever come across",
    name: "Yeshwanth Sundaramurthy",
    url: "https://maps.app.goo.gl/8barbZzXXarhEjvn7"
  },
  {
    text: "Wonderful doctor who explains everything in a very easy language. My go-to gynaecologist.",
    name: "Shreya Dalal",
    url: "https://maps.app.goo.gl/92hAXso5bZounQDdA"
  },
  {
    text: "Enjoyed the way she explains. Kudos to her.",
    name: "Shiv Ahuja",
    url: "https://maps.app.goo.gl/Gs4rEBhZubLSMTtp7"
  },
  {
    text: "Excellent work for our society, which is needful for us",
    name: "Nirmal Singh",
    url: "https://maps.app.goo.gl/Yu4bnH28pMD5JkyR7"
  }
];

const faqs = [
  {
    questionEnglish: "What does Dr Cuterus consult for?",
    questionHinglish: "Dr Cuterus kis kis problem ke liye consult karti hain?",
    answerEnglish: "I consult on a wide range of sexual and reproductive health concerns, including: late or missing periods, PCOD/PCOS/PMOS, difficulty reaching orgasm, pain during sex or being unable to have sex, vaginal discharge concerns, breast-related worries including discharge from breasts, and queer-friendly sexual health consultations. If you're dealing with any of these, you can book a consultation with me directly.",
    answerHinglish: "Main sexual aur reproductive health-related topics par consult karti hoon, jaise: period late ya missing hona, PCOD/PCOS/PMOS, orgasm na aana, sex karte waqt dard ya sex na ho paana, vaginal discharge ki tension, breasts se related worries jaise breasts se discharge, aur queer-friendly sexual health consultations. Agar aapko inme se kuch bhi feel ho raha hai, toh aap directly mere saath consultation book kar sakte hain.",
  },
  {
    questionEnglish: "How can I book an appointment with Dr Cuterus / Dr. Tanaya Narendra?",
    questionHinglish: "Dr Cuterus ya Dr. Tanaya Narendra se appointment kaise book karein?",
    answerEnglish: "The easiest way to book is via WhatsApp. If you're unable to reach me on WhatsApp, you can also email me at drcuterus@gmail.com.",
    answerHinglish: "Sabse easy tareeka hai WhatsApp se book karna. Agar WhatsApp pe mujhse contact nahi ho paata, toh aap mujhe drcuterus@gmail.com par email bhi kar sakte hain.",
  },
  {
    questionEnglish: "Are consultations online or in-person?",
    questionHinglish: "Consultations online hote hain ya in-person?",
    answerEnglish: "All my consultations are conducted online.",
    answerHinglish: "Mere saare consultations online hi hote hain.",
  },
  {
    questionEnglish: "What are Dr Cuterus's consultation timings?",
    questionHinglish: "Dr Cuterus ka consultation timing kya hai?",
    answerEnglish: "I consult on Mondays, Wednesdays, and Fridays, from 3 PM to 6 PM. You can book your slot via WhatsApp.",
    answerHinglish: "Main Monday, Wednesday aur Friday, 3 PM se 6 PM tak consult karti hoon. Apna slot WhatsApp se book kar sakte hain.",
  },
  {
    questionEnglish: "Where can I learn more from Dr Cuterus alongside my appointment?",
    questionHinglish: "Appointment ke saath, Dr Cuterus se aur kahan jaan sakti hoon?",
    answerEnglish: "If you have a specific health concern, it's best to book a consultation with me directly. Alongside that, you can follow me on Instagram and YouTube for daily explainers, listen to The Dr. Cuterus Podcast, or read my bestselling book Dr. Cuterus: Everything Nobody Tells You About Your Body to learn more about your body in everyday language.",
    answerHinglish: "Agar koi specific health concern hai, toh best yahi hai ki directly mere saath consultation book karein. Iske saath, aap mujhe Instagram aur YouTube par follow kar sakte hain daily explainers ke liye, The Dr. Cuterus Podcast sun sakte hain, ya meri bestselling book Dr. Cuterus: Everything Nobody Tells You About Your Body padh sakte hain apne body ke baare mein aasaan bhasha mein aur jaanne ke liye.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.questionEnglish,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answerEnglish,
    },
  })),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Appointments - Dr. Cuterus</title>
    <meta name="description" content="Book an online consultation with Dr. Tanaya Narendra - confidential, judgment-free." />
    <meta property="og:title" content="Appointments - Dr. Cuterus" />
    <meta property="og:description" content="Book an online consultation with Dr. Tanaya Narendra - confidential, judgment-free." />
