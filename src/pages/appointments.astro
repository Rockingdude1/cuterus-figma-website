<script define:vars={{ reviews }}>
  let currentIndex = 0;

  function updateReview() {
    const textEl = document.getElementById('review-text');
    const nameEl = document.getElementById('review-name');
    const cardEl = document.getElementById('review-card');
    if (textEl) textEl.textContent = reviews[currentIndex].text;
    if (nameEl) nameEl.textContent = reviews[currentIndex].name;
    if (cardEl) cardEl.href = reviews[currentIndex].url;
  }

  const prevBtn = document.getElementById('review-prev');
  const nextBtn = document.getElementById('review-next');

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      currentIndex = (currentIndex - 1 + reviews.length) % reviews.length;
      updateReview();
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % reviews.length;
      updateReview();
    });
  }

  updateReview();
</script>

<style>
  body {
    background-color: var(--color-beige-500);
    margin: 0;
    padding: 0;
  }

  /* ── SECTION 1: HERO ── */
  .appt-hero-outer {
    padding-top: 80px;
  }

  .appt-hero-top,
  .appt-hero-bottom {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 60px;
  }

  .appt-hero-bottom {
    padding-bottom: 10px;
  }

  .appt-hero__label {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: rgba(28, 20, 23, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 24px 0 8px;
    text-align: center;
  }

  /* Tag cloud: purple grid bg */
  .appt-hero__tag-cloud {
    width: 100%;
    height: 305px;
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.15) 1px, transparent 1px);
    background-size: 32px 32px;
    position: relative;
    flex-shrink: 0;
  }

  /* Desktop: absolute scatter layout */
  .appt-tag-group {
    position: absolute;
    inset: 0;
  }

  /* Heading inside the grid */
  .appt-hero__heading {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(2.5rem, 4.375vw, 3.5rem);
    color: var(--color-brand-600);
    letter-spacing: -0.06em;
    line-height: 1.05;
    margin: 0;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    z-index: 1;
  }

  /* Individual floating tags */
  .appt-tag {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(0.875rem, 1.875vw, 1.5rem);
    padding: 8px 16px;
    border-radius: 0;
    border: 1px solid var(--color-black);
    text-align: center;
    line-height: 1.1;
    white-space: nowrap;
    filter: drop-shadow(1px 2px 4px rgba(0,0,0,0.25));
  }

  .appt-tag--yellow-light {
    background-color: #ffe07f;
    color: var(--color-black);
  }

  .appt-tag--white {
    background-color: #fefefe;
    color: var(--color-black);
  }

  .appt-tag--purple-dark {
    background-color: var(--color-brand-400);
    color: var(--color-brand-50);
  }

  /* Desktop scatter positions — 9 tags */
  .appt-tag--p1 { left: 67.9%; top: 59.0%; transform: rotate(3.16deg);  }
  .appt-tag--p2 { left: 66.5%; top: 33.8%; transform: rotate(-3.89deg); }
  .appt-tag--p3 { left: 67.9%; top: 17.7%; transform: rotate(1.71deg);  }
  .appt-tag--p4 { left: 40.1%; top: 10.5%; transform: rotate(-3.23deg); }
  .appt-tag--p5 { left: 14.0%; top: 8.5%;  transform: rotate(2.49deg);  }
  .appt-tag--p6 { left: 7.3%;  top: 29.5%; }
  .appt-tag--p7 { left: 16.5%; top: 49.5%; transform: rotate(5.14deg);  }
  .appt-tag--p8 { left: 47.2%; top: 74.1%; transform: rotate(-2.68deg); }
  .appt-tag--p9 { left: 14.5%; top: 73.1%; }

  .appt-hero__tagline {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-brand-900);
    margin: 28px 0 20px;
    text-align: center;
  }

  .appt-cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #fff;
    flex-shrink: 0;
  }

  .appt-hero__cta {
    font-size: 1.5rem;
    padding: 8px 20px;
    background-color: var(--color-brand-300);
    display: inline-flex;
    align-items: center;
    gap: 10px;
