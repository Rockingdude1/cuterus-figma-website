---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Corporate Workshops — Dr. Cuterus</title>
    <meta name="description" content="Interactive workshops on sexual and reproductive health, built for teams who want to do inclusion right." />
  </head>
  <body>
    <Navbar />

    <!-- HERO TEXT -->
    <div class="workshops-hero">
      <h1 class="workshops-hero__heading">Want to conduct a workshop? Get in touch.</h1>
      <p class="workshops-hero__sub">Interactive workshops on sexual and reproductive health, built for teams who want to do inclusion right</p>
    </div>

    <!-- PHOTO COLLAGE -->
    <div class="workshops-collage">

      <!-- Washi tape strips -->
      <img src="/workshops/tape.png"  class="col-tape col-tape--left"  alt="" aria-hidden="true" />
      <img src="/workshops/tape2.png" class="col-tape col-tape--right" alt="" aria-hidden="true" />

      <!-- Heart decoration -->
      <img src="/workshops/heart.svg" class="col-heart" alt="" aria-hidden="true" />

      <!-- Pin dots -->
      <img src="/workshops/ellipse-b.svg" class="col-dot" style="left:665px;top:63px"  alt="" aria-hidden="true" />
      <img src="/workshops/ellipse-a.svg" class="col-dot" style="left:1061px;top:297px" alt="" aria-hidden="true" />
      <img src="/workshops/ellipse-a.svg" class="col-dot" style="left:367px;top:316px"  alt="" aria-hidden="true" />

      <!-- photo-64: large yellow landscape (top right) -->
      <div class="col-photo col-photo--64">
        <img src="/workshops/photo-64.png" alt="" />
      </div>

      <!-- photo-53: large white polaroid (left) -->
      <div class="col-photo col-photo--53">
        <img src="/workshops/photo-53.png" alt="Dr. Tanaya at a speaking event" />
      </div>

      <!-- photo-61: medium purple polaroid (center) -->
      <div class="col-photo col-photo--61">
        <img src="/workshops/photo-61.png" alt="" />
      </div>

      <!-- photo-59: small square (top centre) -->
      <div class="col-photo col-photo--59">
        <img src="/workshops/photo-59.png" alt="" />
      </div>

      <!-- photo-57: small white photo -->
      <div class="col-photo col-photo--57">
        <img src="/workshops/photo-57.png" alt="" />
      </div>

      <!-- photo-56: small yellow polaroid -->
      <div class="col-photo col-photo--56">
        <img src="/workshops/photo-56.png" alt="" />
      </div>

      <!-- photo-62: medium yellow-light polaroid (right centre) -->
      <div class="col-photo col-photo--62">
        <img src="/workshops/photo-62.png" alt="" />
      </div>

      <!-- photo-58: small purple polaroid (far right) -->
      <div class="col-photo col-photo--58">
        <img src="/workshops/photo-58.png" alt="" />
      </div>

      <!-- photo-51: wide landscape (bottom right, no border) -->
      <div class="col-photo col-photo--51">
        <img src="/workshops/photo-51.png" alt="" />
      </div>

      <!-- Dr Cuterus badges -->
      <img src="/workshops/badge.png" class="col-badge col-badge--1" alt="" aria-hidden="true" />
      <img src="/workshops/badge.png" class="col-badge col-badge--2" alt="" aria-hidden="true" />

    </div><!-- end .workshops-collage -->

    <!-- YELLOW TICKER (same as home page) -->
    <div class="workshops__ticker" aria-label="Featured in">
      <div class="workshops__ticker-track">
        <img src="/logos/forbes.svg"          alt="Forbes India"                        class="workshops__ticker-logo" />
        <img src="/logos/who.svg"              alt="World Health Organization"           class="workshops__ticker-logo" />
        <img src="/logos/delhi.svg"            alt="Government of Delhi"                 class="workshops__ticker-logo workshops__ticker-logo--sq" />
        <img src="/logos/natgeo.svg"           alt="National Geographic"                 class="workshops__ticker-logo" />
        <img src="/logos/gates.svg"            alt="Gates Foundation"                    class="workshops__ticker-logo" />
        <img src="/logos/better_india.svg"     alt="The Better India"                    class="workshops__ticker-logo workshops__ticker-logo--sq" />
        <img src="/logos/cosmo.svg"            alt="Cosmopolitan India"                  class="workshops__ticker-logo" />
        <img src="/logos/hindustan_times.svg"  alt="Hindustan Times"                     class="workshops__ticker-logo" />
        <img src="/logos/fii.svg"              alt="Feminism in India"                   class="workshops__ticker-logo" />
        <img src="/logos/vogue.svg"            alt="Vogue India"                         class="workshops__ticker-logo" />
        <img src="/logos/india_govt.svg"       alt="Ministry of Health"                  class="workshops__ticker-logo" />
        <img src="/logos/umich.svg"            alt="University of Michigan"              class="workshops__ticker-logo" />
        <!-- duplicate set for seamless loop -->
        <img src="/logos/forbes.svg"          alt="" class="workshops__ticker-logo" />
        <img src="/logos/who.svg"              alt="" class="workshops__ticker-logo" />
        <img src="/logos/delhi.svg"            alt="" class="workshops__ticker-logo workshops__ticker-logo--sq" />
        <img src="/logos/natgeo.svg"           alt="" class="workshops__ticker-logo" />
        <img src="/logos/gates.svg"            alt="" class="workshops__ticker-logo" />
        <img src="/logos/better_india.svg"     alt="" class="workshops__ticker-logo workshops__ticker-logo--sq" />
        <img src="/logos/cosmo.svg"            alt="" class="workshops__ticker-logo" />
        <img src="/logos/hindustan_times.svg"  alt="" class="workshops__ticker-logo" />
        <img src="/logos/fii.svg"              alt="" class="workshops__ticker-logo" />
        <img src="/logos/vogue.svg"            alt="" class="workshops__ticker-logo" />
        <img src="/logos/india_govt.svg"       alt="" class="workshops__ticker-logo" />
        <img src="/logos/umich.svg"            alt="" class="workshops__ticker-logo" />
      </div>
    </div>

    <!-- FOOTER -->
    <div class="partnerships-footer">
      <p class="partnerships-footer__heading">Found something you liked? Let's talk.</p>
      <p class="partnerships-footer__sub">For collabs, speaking, and partnerships or just to say hi!</p>
      <a href="https://mail.google.com/mail/?view=cm&to=drcuterus@gmail.com" target="_blank" rel="noopener" class="btn-primary">Work with Me</a>
    </div>

  </body>
</html>

<script>
  const track = document.querySelector<HTMLElement>('.workshops__ticker-track');
  if (track) {
    const imgs = track.querySelectorAll('img');
    let loaded = 0;
    const total = imgs.length;
    const ready = () => { if (++loaded >= total) track.classList.add('ticker-ready'); };
    imgs.forEach(img => {
      if ((img as HTMLImageElement).complete) ready();
      else img.addEventListener('load', ready);
      img.addEventListener('error', ready);
    });
  }
</script>

<style>
  body {
    background-color: var(--color-beige-500);
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .workshops-hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 120px 60px 0;
    box-sizing: border-box;
    text-align: center;
  }

  .workshops-hero__heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2rem, 3.75vw, 3rem);
    color: var(--color-brand-400);
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 0 0 20px;
  }

  .workshops-hero__sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    color: var(--color-brand-900);
    margin: 0 0 28px;
    line-height: 1.4;
  }

  /* ── COLLAGE ── */
  .workshops-collage {
    position: relative;
    height: 660px;
    max-width: 1280px;
    margin: 0 auto;
    overflow: hidden;
  }

  /* Shared polaroid frame */
  .col-photo {
    position: absolute;
    overflow: hidden;
    box-shadow: 1px 4px 8px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
  }
  .col-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* ── Individual photo positions & borders ── */

  /* Large yellow landscape — top right */
  .col-photo--64 {
    left: 754px; top: 127px;
    width: 499px; height: 208px;
    border: 12px solid var(--color-yellow-500);
    border-bottom-width: 49px;
  }
  .col-photo--64 img {
    object-position: center 55%;
  }

  /* Large white polaroid — left */
  .col-photo--53 {
    left: 57px; top: 74px;
    width: 356px; height: 414px;
    transform: rotate(-1.6deg);
    border: 16px solid var(--color-white);
    border-bottom-width: 48px;
  }

  /* Medium purple polaroid — centre */
  .col-photo--61 {
    left: 420px; top: 97px;
    width: 328px; height: 471px;
    transform: rotate(1.64deg);
    border: 16px solid var(--color-brand-100);
    border-bottom-width: 48px;
  }

  /* Small square — top centre */
  .col-photo--59 {
    left: 354px; top: 19px;
    width: 159px; height: 159px;
    border: 5px solid var(--color-yellow-200);
    border-bottom-width: 21px;
  }
  .col-photo--59 img { transform: scale(1.5); }

  /* Small white photo */
  .col-photo--57 {
    left: 586px; top: 81px;
    width: 180px; height: 120px;
    border: 8px solid var(--color-white);
    border-bottom-width: 23px;
  }

  /* Small yellow polaroid */
  .col-photo--56 {
    left: 306px; top: 319px;
    width: 130px; height: 173px;
    border: 8px solid var(--color-yellow-500);
    border-bottom-width: 24px;
  }

  /* Medium yellow-light polaroid — right centre */
  .col-photo--62 {
    left: 747px; top: 287px;
    width: 256px; height: 262px;
    transform: rotate(7.71deg);
    border: 9px solid var(--color-yellow-200);
    border-bottom-width: 35px;
  }
  .col-photo--62 img {
    object-position: center 55%;
  }

  /* Small purple polaroid — far right */
  .col-photo--58 {
    left: 984px; top: 282px;
    width: 199px; height: 265px;
    transform: rotate(-6.13deg);
    border: 8px solid var(--color-brand-100);
    border-bottom-width: 29px;
  }
  .col-photo--58 img { transform: scale(1.5); }

  /* Wide landscape — bottom right, no polaroid border */
  .col-photo--51 {
    left: 876px; top: 460px;
    width: 257px; height: 159px;
    box-shadow: none;
  }
  .col-photo--51 img {
    object-position: center 68%;
  }

  /* ── Decorative elements ── */
  .col-badge {
    position: absolute;
    width: 99px;
    height: 90px;
    object-fit: contain;
    pointer-events: none;
  }
  .col-badge--1 { left: 721px; top: 239px; }
  .col-badge--2 { left: 366px; top: 464px; }

  .col-tape {
    position: absolute;
    width: 185px;
    height: 91px;
    object-fit: contain;
    opacity: 0.85;
    pointer-events: none;
  }
  .col-tape--left  { left: 125px; top: 23px; }
  .col-tape--right {
    left: 1117px; top: 81px;
    transform: rotate(24.31deg);
    transform-origin: center center;
  }

  .col-heart {
    position: absolute;
    left: 485px; top: 16px;
    width: 77px; height: 52px;
    pointer-events: none;
    z-index: 10;
  }

  .col-dot {
    position: absolute;
    width: 20px; height: 20px;
    pointer-events: none;
  }

  /* ── YELLOW TICKER ── */
  .workshops__ticker {
    width: 100%;
    height: 60px;
    background-color: var(--color-yellow-500);
    overflow: hidden;
  }

  @keyframes workshops-ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .workshops__ticker-track {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
    height: 100%;
    animation: workshops-ticker 50s linear infinite;
    animation-play-state: paused;
    will-change: transform;
    padding: 0 32px;
  }

  .workshops__ticker-track.ticker-ready {
    animation-play-state: running;
  }

  .workshops__ticker-logo {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    display: block;
    object-fit: contain;
    filter: brightness(0);
  }
  .workshops__ticker-logo--sq { height: 38px; }

  /* ── FOOTER (same as existing partnerships footer) ── */
  .partnerships-footer {
    background-color: var(--color-brand-100);
    background-image:
      linear-gradient(rgba(110, 57, 151, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(110, 57, 151, 0.08) 1px, transparent 1px);
    background-size: 40px 40px;
    height: 266px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .partnerships-footer__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-brand-900);
    margin: 0;
    letter-spacing: -0.06em;
    line-height: 0.95;
    text-align: center;
  }

  .partnerships-footer__sub {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-brand-900);
    margin: 0;
    text-align: center;
  }

  /* ── MOBILE (≤768px) ── */
  @media (max-width: 768px) {
    .workshops-hero {
      padding: 72px 20px 0;
    }

    .workshops-hero__heading {
      font-size: 32px;
      letter-spacing: -0.05em;
      margin-bottom: 12px;
    }

    /* Subheading not shown on mobile */
    .workshops-hero__sub {
      display: none;
    }

    /* Collage: absolute layout matching Figma 390px mobile frame */
    .workshops-collage {
      display: block;
      height: 470px;
      max-width: 390px;
      overflow: hidden;
      padding: 0;
    }

    /* Re-show all decorative elements */
    .col-tape, .col-heart, .col-dot, .col-badge { display: block; }

    /* Reset any desktop img scale transforms */
    .col-photo--58 img, .col-photo--59 img { transform: none; }

    /* ── Mobile photo positions (ref: 390px frame) ── */

    .col-photo--64 {
      left: 162px; top: 67px;
      width: 246px; height: 102px;
      border-width: 5px; border-bottom-width: 20px;
    }

    .col-photo--53 {
      left: -8px; top: 22px;
      width: 175px; height: 204px;
      border-width: 6.5px; border-bottom-width: 20px;
    }

    .col-photo--61 {
      left: 112px; top: 192px;
      width: 161px; height: 232px;
      border-width: 6.5px; border-bottom-width: 20px;
    }

    .col-photo--59 {
      left: 149px; top: 13px;
      width: 63px; height: 63px;
      transform: rotate(-7.74deg);
      border-width: 2px; border-bottom-width: 7px;
    }

    .col-photo--56 {
      left: 47px; top: 253px;
      width: 64px; height: 85px;
      border-width: 3px; border-bottom-width: 10px;
    }

    .col-photo--57 {
      display: block;
      left: 278px; top: 295px;
      width: 89px; height: 59px;
      border-width: 3px; border-bottom-width: 9px;
    }

    .col-photo--58 {
      left: 35px; top: 346px;
      width: 78px; height: 104px;
      border-width: 2px; border-bottom-width: 10px;
    }

    .col-photo--62 {
      left: 275px; top: 183px;
      width: 101px; height: 103px;
      border-width: 3px; border-bottom-width: 11px;
    }

    .col-photo--51 {
      left: 267px; top: 338px;
      width: 126px; height: 79px;
    }

    /* ── Mobile decorative element positions ── */

    .col-tape--left  { left: 35px;  top: 0px;  width: 91px; height: 45px; transform: none; }
    .col-tape--right { left: 328px; top: 40px; width: 91px; height: 45px; transform: rotate(24.31deg); }

    .col-heart { left: 29px; top: 233px; width: 35px; height: 30px; }

    .col-badge--1 { left: 148px; top: 169px; width: 49px; height: 44px; }
    .col-badge--2 { left: 249px; top: 272px; width: 49px; height: 44px; }

    .col-dot[style*="left:665px"]  { left: 72px  !important; top: 243px !important; }
    .col-dot[style*="left:1061px"] { left: 335px !important; top: 180px !important; }
    .col-dot[style*="left:367px"]  { display: none; }
  }

  /* ── TABLET (769–1100px) ── */
  @media (min-width: 769px) and (max-width: 1100px) {
    .workshops-collage {
      height: 520px;
      transform-origin: top left;
    }

    /* Scale the collage proportionally */
    .workshops-collage > * {
      transform-origin: top left;
    }
  }
</style>
